{
	"info": {
		"_postman_id": "guardians-full-test-2024",
		"name": "Guardians Backend - Full Feature Test",
		"description": "Complete test suite for all 6 features:\n1. Pairing between devices\n2. Location child\n3. Block apps\n4. Block device\n5. Screen time\n6. Access on (apps, sms, calls)\n\n**Run requests IN ORDER** — each step depends on the previous one.\nTokens and IDs are auto-extracted via test scripts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "parentEmail", "value": "parent@test.com" },
		{ "key": "parentPassword", "value": "SecurePass123!" },
		{ "key": "parentFullName", "value": "Ahmed Hassan" },
		{ "key": "childEmail", "value": "child@test.com" },
		{ "key": "childPassword", "value": "ChildPass123!" },
		{ "key": "childFullName", "value": "Omar Hassan" },
		{ "key": "parentToken", "value": "" },
		{ "key": "childToken", "value": "" },
		{ "key": "parentUserId", "value": "" },
		{ "key": "childUserId", "value": "" },
		{ "key": "parentDeviceId", "value": "parent-device-001" },
		{ "key": "childDeviceId", "value": "child-device-001" },
		{ "key": "pairingCode", "value": "" }
	],
	"item": [
		{
			"name": "🔐 1. PAIRING — Device Pairing Flow",
			"description": "Complete pairing flow: register both users, generate code, link devices.",
			"item": [
				{
					"name": "1.1 Register Parent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Parent registered successfully', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.token).to.be.a('string');",
									"    pm.collectionVariables.set('parentToken', json.token);",
									"    pm.collectionVariables.set('parentUserId', json.userId);",
									"    console.log('Parent token saved, userId:', json.userId);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{parentEmail}}\",\n  \"fullName\": \"{{parentFullName}}\",\n  \"password\": \"{{parentPassword}}\",\n  \"phone\": \"+201001234567\",\n  \"role\": \"PARENT\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
					}
				},
				{
					"name": "1.2 Login Parent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Parent logged in', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('parentToken', json.token);",
									"    console.log('Parent token refreshed');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{parentEmail}}\",\n  \"password\": \"{{parentPassword}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
					}
				},
				{
					"name": "1.3 Get Parent Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Profile returned', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.email).to.eql(pm.collectionVariables.get('parentEmail'));",
									"    pm.expect(json.role).to.eql('PARENT');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
					}
				},
				{
					"name": "1.4 Register Parent Device",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Parent device registered', function() {",
									"    pm.response.to.have.status(201);",
									"    var json = pm.response.json();",
									"    pm.expect(json.deviceId).to.eql(pm.collectionVariables.get('parentDeviceId'));",
									"    pm.expect(json.type).to.eql('PARENT');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{parentToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceId\": \"{{parentDeviceId}}\",\n  \"deviceName\": \"Ahmed's Phone\",\n  \"type\": \"PARENT\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/devices/register", "host": ["{{baseUrl}}"], "path": ["devices", "register"] }
					}
				},
				{
					"name": "1.5 Generate Pairing Code (Parent)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Pairing code generated', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.code).to.match(/^\\d{6}$/);",
									"    pm.collectionVariables.set('pairingCode', json.code);",
									"    console.log('Pairing code:', json.code, '| Expires:', json.expiresAt);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": { "raw": "{{baseUrl}}/devices/pairing/generate", "host": ["{{baseUrl}}"], "path": ["devices", "pairing", "generate"] }
					}
				},
				{
					"name": "1.6 Register Child",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Child registered', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('childToken', json.token);",
									"    pm.collectionVariables.set('childUserId', json.userId);",
									"    console.log('Child token saved, userId:', json.userId);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{childEmail}}\",\n  \"fullName\": \"{{childFullName}}\",\n  \"password\": \"{{childPassword}}\",\n  \"role\": \"CHILD\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
					}
				},
				{
					"name": "1.7 Use Pairing Code (Child — WITH auth)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Pairing successful', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.success).to.be.true;",
									"    pm.expect(json.parentName).to.eql(pm.collectionVariables.get('parentFullName'));",
									"    console.log('Paired with parent:', json.parentName);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{childToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"{{pairingCode}}\",\n  \"deviceId\": \"{{childDeviceId}}\",\n  \"deviceName\": \"Omar's Phone\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/devices/pairing/connect", "host": ["{{baseUrl}}"], "path": ["devices", "pairing", "connect"] }
					}
				},
				{
					"name": "1.8 Get Linked Children (Parent)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Children listed', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.be.an('array').with.length.greaterThan(0);",
									"    pm.expect(json[0].deviceId).to.eql(pm.collectionVariables.get('childDeviceId'));",
									"    console.log('Linked children:', json.length);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": { "raw": "{{baseUrl}}/devices/children", "host": ["{{baseUrl}}"], "path": ["devices", "children"] }
					}
				},
				{
					"name": "1.9 Child Heartbeat (Ping)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Heartbeat OK', function() {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": { "raw": "{{baseUrl}}/devices/{{childDeviceId}}/ping", "host": ["{{baseUrl}}"], "path": ["devices", "{{childDeviceId}}", "ping"] }
					}
				}
			]
		},
		{
			"name": "📍 2. LOCATION — Child Location Tracking",
			"description": "Child sends GPS, parent reads it.",
			"item": [
				{
					"name": "2.1 Child Sends Location",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Location updated', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('updated');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{childToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceId\": \"{{childDeviceId}}\",\n  \"latitude\": 30.0444,\n  \"longitude\": 31.2357\n}"
						},
						"url": { "raw": "{{baseUrl}}/location/update", "host": ["{{baseUrl}}"], "path": ["location", "update"] }
					}
				},
				{
					"name": "2.2 Parent Gets Child Location",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Location returned', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.latitude).to.eql(30.0444);",
									"    pm.expect(json.longitude).to.eql(31.2357);",
									"    pm.expect(json.deviceId).to.eql(pm.collectionVariables.get('childDeviceId'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": { "raw": "{{baseUrl}}/location/{{childDeviceId}}", "host": ["{{baseUrl}}"], "path": ["location", "{{childDeviceId}}"] }
					}
				},
				{
					"name": "2.3 Child Updates Location (Moved)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Location updated again', function() {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{childToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceId\": \"{{childDeviceId}}\",\n  \"latitude\": 30.0500,\n  \"longitude\": 31.2400\n}"
						},
						"url": { "raw": "{{baseUrl}}/location/update", "host": ["{{baseUrl}}"], "path": ["location", "update"] }
					}
				},
				{
					"name": "2.4 Parent Gets ALL Children Locations",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('All children locations returned', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    var childId = pm.collectionVariables.get('childDeviceId');",
									"    pm.expect(json).to.have.property(childId);",
									"    pm.expect(json[childId].latitude).to.eql(30.05);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": { "raw": "{{baseUrl}}/location/children", "host": ["{{baseUrl}}"], "path": ["location", "children"] }
					}
				}
			]
		},
		{
			"name": "🚫 3. BLOCK APPS — App Blocking",
			"description": "Parent blocks apps, child polls block list.",
			"item": [
				{
					"name": "3.1 Parent Blocks Apps",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Apps blocked', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('blocked');",
									"    pm.expect(json.packages).to.include('com.instagram.android');",
									"    pm.expect(json.packages).to.include('com.zhiliaoapp.musically');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{parentToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"packages\": [\n    \"com.instagram.android\",\n    \"com.zhiliaoapp.musically\",\n    \"com.snapchat.android\"\n  ]\n}"
						},
						"url": { "raw": "{{baseUrl}}/apps/{{childDeviceId}}/block", "host": ["{{baseUrl}}"], "path": ["apps", "{{childDeviceId}}", "block"] }
					}
				},
				{
					"name": "3.2 Child Polls Blocked Apps",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Blocked list returned', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.packages).to.be.an('array').with.length(3);",
									"    pm.expect(json.packages).to.include('com.instagram.android');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/apps/{{childDeviceId}}/blocked", "host": ["{{baseUrl}}"], "path": ["apps", "{{childDeviceId}}", "blocked"] }
					},
					"description": "No auth needed — child polls this from background service."
				},
				{
					"name": "3.3 Parent Unblocks Single App",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Single app unblocked', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('unblocked');",
									"    pm.expect(json.packageName).to.eql('com.snapchat.android');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/apps/{{childDeviceId}}/unblock/single?packageName=com.snapchat.android",
							"host": ["{{baseUrl}}"],
							"path": ["apps", "{{childDeviceId}}", "unblock", "single"],
							"query": [{ "key": "packageName", "value": "com.snapchat.android" }]
						}
					}
				},
				{
					"name": "3.4 Verify Block List After Unblock",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Snapchat removed from block list', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.packages).to.have.length(2);",
									"    pm.expect(json.packages).to.not.include('com.snapchat.android');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/apps/{{childDeviceId}}/blocked", "host": ["{{baseUrl}}"], "path": ["apps", "{{childDeviceId}}", "blocked"] }
					}
				},
				{
					"name": "3.5 Parent Unblocks All Apps",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('All apps unblocked', function() {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('unblocked');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{parentToken}}" }],
						"url": { "raw": "{{baseUrl}}/apps/{{childDeviceId}}/unblock", "host": ["{{baseUrl}}"], "path": ["apps", "{{childDeviceId}}", "unblock"] }
					}
				},
				{
					"name": "3.6 Verify Empty Block List",
					"event": [
						{
							"listen": "test",
